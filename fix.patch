+# =========================================================
+# Spell-save helpers (para conjuros a salvación: Hypnotic Pattern, etc.)
+# =========================================================
+_SAVE_WORD_TO_ABILITY = {
+    "strength": "str",
+    "dexterity": "dex",
+    "constitution": "con",
+    "intelligence": "int",
+    "wisdom": "wis",
+    "charisma": "cha",
+}
+
+_SAVE_RE = re.compile(r"\b(Strength|Dexterity|Constitution|Intelligence|Wisdom|Charisma)\s+saving\s+throw\b", re.IGNORECASE)
+
+
+def _infer_save_ability_from_spell_def(spell_def: Optional[dict]) -> Optional[str]:
+    """Intenta inferir la habilidad de salvación leyendo el texto del conjuro."""
+    if not spell_def:
+        return None
+    txt = spell_def.get("text")
+    parts = []
+    if isinstance(txt, list):
+        parts = [str(x) for x in txt if x]
+    elif isinstance(txt, str):
+        parts = [txt]
+    blob = "\n".join(parts)
+    m = _SAVE_RE.search(blob)
+    if not m:
+        return None
+    word = m.group(1).strip().lower()
+    return _SAVE_WORD_TO_ABILITY.get(word)
+
+
+def _spell_duration_to_rounds(spell_def: Optional[dict], fallback_rounds: int = 1) -> int:
+    """Convierte duration tipo 'up to 1 minute' a rondas (aprox)."""
+    if not spell_def:
+        return fallback_rounds
+    dur = (spell_def.get("duration") or "").strip().lower()
+    if "minute" in dur:
+        return 10
+    if "hour" in dur:
+        return 600
+    if "round" in dur:
+        m = re.search(r"(\d+)", dur)
+        if m:
+            try:
+                return max(1, int(m.group(1)))
+            except Exception:
+                pass
+    return fallback_rounds
+
+
+def _get_entity_ability_score(canon: dict, name: str, ability: str) -> int:
+    """Devuelve score (STR/DEX/...) desde party/enemies, o 10 si no se sabe."""
+    ability = _norm(ability)
+    pm = _find_party_member(canon, name)
+    if pm and isinstance(pm.get("abilities"), dict):
+        try:
+            return int(pm["abilities"].get(ability, 10) or 10)
+        except Exception:
+            return 10
+
+    fe = _find_enemy(canon, name)
+    if fe:
+        _, obj = fe
+        try:
+            return int(obj.get(ability, 10) or 10)
+        except Exception:
+            return 10
+
+    return 10
+
+
+def _get_save_bonus(canon: dict, name: str, ability: str) -> int:
+    """Bonus de salvación (heurístico): mod(ability)."""
+    score = _get_entity_ability_score(canon, name, ability)
+    return _ability_mod(score)
+
+
+def _calc_spell_save_dc(canon: dict, actor: str, override: Optional[int] = None) -> int:
+    """DC del conjuro: override si viene; si no, usa actor.spell_save_dc o 8+PB+mod(ability) heurístico."""
+    if override is not None:
+        try:
+            v = int(override)
+            if 1 <= v <= 30:
+                return v
+        except Exception:
+            pass
+
+    pm = _find_party_member(canon, actor)
+    if pm:
+        try:
+            v = int(pm.get("spell_save_dc", 0) or 0)
+            if 1 <= v <= 30:
+                return v
+        except Exception:
+            pass
+
+        pb = int(pm.get("prof_bonus", 0) or 0)
+        abilities = pm.get("abilities", {}) if isinstance(pm.get("abilities"), dict) else {}
+        best = max(_ability_mod(abilities.get("int", 10)), _ability_mod(abilities.get("wis", 10)), _ability_mod(abilities.get("cha", 10)))
+        dc = 8 + pb + best
+        return max(8, min(30, dc))
+
+    return 13
